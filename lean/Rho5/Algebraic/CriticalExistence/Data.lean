def midpoint : Vec := fun i => (midQ i : ℝ)
def radius : Vec := fun i => (radQ i : ℝ)
def pointBox : QBox := fun i => QI.pt (midQ i)
def InBox (v : Vec) : Prop := MemBox exactBox v

theorem radius_pos (i : Fin 4) : 0 < radius i := by
  fin_cases i <;> norm_num [radius,radQ]
theorem endpoints (i : Fin 4) :
    ((exactBox i).lo : ℝ) = midpoint i-radius i ∧
    ((exactBox i).hi : ℝ) = midpoint i+radius i := by
  fin_cases i <;> norm_num [exactBox,midpoint,radius,midQ,radQ]
theorem inBox_iff_centered (v : Vec) : InBox v ↔ CenteredBox midpoint radius v := by
  constructor
  · intro h i
    have hi := h i
    simpa only [QI.Mem,(endpoints i).1,(endpoints i).2] using hi
  · intro h i
    have hi := h i
    simpa only [QI.Mem,(endpoints i).1,(endpoints i).2] using hi

theorem box_subset_coarse (i : Fin 4) : (exactBox i).Subset (coarseBox i) := by
  fin_cases i <;> norm_num [exactBox,coarseBox,QI.Subset]
theorem in_coarse {v : Vec} (hv : InBox v) : MemBox coarseBox v := by
  intro i; exact QI.mem_subset (box_subset_coarse i) (hv i)
theorem midpoint_mem_point : MemBox pointBox midpoint := by
  intro i; simp [pointBox,midpoint,QI.pt,QI.Mem]
