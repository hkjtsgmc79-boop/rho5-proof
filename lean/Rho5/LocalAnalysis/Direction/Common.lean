/-- Compact enclosure of the actual second-order remainder. -/
theorem directionApprox_error (h : WholeBoxResidual) (z : X)
    (hz : z ∈ cube center radius) :
    ‖inverseDirection h z hz - directionApprox z‖ ≤ (17 / 200 : ℝ) := by
  have hn : ‖preconditioner consumeBasis‖ ≤ (21 / 10 : ℝ) := by
    rw [← directionBase_eq]
    exact directionBase_bound
  have he := second_order_remainder (jacobian z).toLinearMap preconditioner
    qBound_nonneg (lt_trans qBound_lt (by norm_num : (1 : ℝ)/5 < 1))
    (h z hz) consumeBasis (inverseDirection h z hz)
    (inverseDirection_equation h z hz) hn
  have hnumerical : (21 / 10 : ℝ) * qBound ^ 2 / (1-qBound) ≤ 17 / 200 := by
    norm_num [qBound]
  apply le_trans _ hnumerical
  simpa only [directionApprox, directionBase_eq] using he

