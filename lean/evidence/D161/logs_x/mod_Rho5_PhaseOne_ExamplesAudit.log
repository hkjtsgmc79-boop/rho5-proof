Rho5.PhaseOne.Examples.exists_global_maximizer : ∃ P values,
  And (Rho5.BoundaryMaximizer.SortedBoundaryMaximizerFacts P values)
    (And (Rho5.ExternalTailSaturation.LeadingInput P)
      (And (Eq.{1} (Rho5.ExternalTailSaturation.height P) Rho5.GrowthSupremum.rho5Trace)
        (And (LT.lt.{0} 4 (Rho5.ExternalTailSaturation.height P))
          (And (Eq.{1} (Rho5.matrixEntryMax P) 1)
            (And
              (Rho5.CompletePivotPath.LegalTrace P
                (List.cons.{0} 1
                  (List.cons.{0} (Rho5.Certificate.B24Extraction.p P)
                    (List.cons.{0} (Rho5.Certificate.B24Extraction.k P)
                      (List.cons.{0} (abs.{0} (Rho5.Certificate.B24Extraction.r P))
                        (List.cons.{0} (Rho5.ExternalTailSaturation.height P) List.nil.{0}))))))
              (And (Eq.{1} (Rho5.GrowthModel.growthRatio P values) Rho5.GrowthSupremum.rho5Trace)
                (∀ (M : Rho5.Matrix5),
                  Ne.{1} M 0 →
                    ∀ (ws : List.{0} Real),
                      Rho5.CompletePivotPath.LegalTrace M ws →
                        LE.le.{0} (Rho5.GrowthModel.growthRatio M ws) (Rho5.GrowthModel.growthRatio P values))))))))
