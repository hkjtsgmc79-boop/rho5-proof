def Rho5.Integration.StagedAssembly.ActualXBranch : Rho5.Matrix5 → Rho5.Matrix5 → Prop :=
fun P N =>
  ∃ x,
    And (Rho5.LocalAnalysis.V43.Physical x)
      (And (Eq.{1} (Rho5.Shared.ActualXBReduction.reconstruct x) N)
        (Eq.{1} (Rho5.LocalAnalysis.height x) (Rho5.ExternalTailSaturation.height P)))
def Rho5.Integration.StagedAssembly.ActualBRootEndpointBranch : Rho5.Matrix5 → Prop :=
fun N =>
  ∃ z sg,
    And (Rho5.Integration.StagedAssembly.ActualRootRepresentative N z sg)
      (∃ y zStar sg₂, Rho5.Integration.StagedAssembly.RootCapacityWitness z y zStar sg₂)
def Rho5.Integration.StagedAssembly.XGlobalSafety : Prop :=
∀ (x : Rho5.LocalAnalysis.X),
  Rho5.LocalAnalysis.V43.Physical x → LE.le.{0} (Rho5.LocalAnalysis.height x) Rho5.Algebraic.AlphaRoot.alpha
def Rho5.Shared.BRootCapacityEndpoint.IsRootCapacityEndpoint : Rho5.Certificate.B16.Point → Prop :=
fun zStar =>
  ∃ y,
    And (Rho5.ExternalBFibreCapacity.NormalizedB y)
      (And (Rho5.Shared.PaperB17RootEntry.B17Root (Rho5.ExternalBFibreCapacity.frameOf y))
        (Eq.{1} zStar (Rho5.ExternalBFibreCapacity.canonicalPoint (Rho5.ExternalBFibreCapacity.frameOf y))))
def Rho5.Shared.BRootCapacityEndpoint.RootEndpointSafety : Prop :=
∀ (zStar : Rho5.Certificate.B16.Point),
  Rho5.Shared.BRootCapacityEndpoint.IsRootCapacityEndpoint zStar → LE.le.{0} (zStar 23) Rho5.Algebraic.AlphaRoot.alpha
