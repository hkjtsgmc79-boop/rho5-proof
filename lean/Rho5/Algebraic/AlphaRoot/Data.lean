/-- Exactly q_0 + q_1*t + ... + q_61*t^61, using its sign split at degree 9. -/
def transformedPolynomial (t : ℝ) : ℝ :=
  t^9 * evalInts Data.positiveCoefficients t - evalInts Data.negativeCoefficients t

/-- This is Q(t)/t^8 for t nonzero, not Q(t). -/
def scaledTransform (t : ℝ) : ℝ :=
  t * evalInts Data.positiveCoefficients t -
    evalInts Data.reversedNegativeCoefficients (1/t)

