/-- Coefficient agreement, indexed as the two sums index it. -/
theorem eval_pcAt (x y z g : ℝ) (i : Fin 11) :
    ev (point x y z g) (pcAt i) = bezoutPcAt g i := by
  fin_cases i <;>
    simp only [pcAt, bezoutPcAt, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, Matrix.cons_val_fin_one] <;>
    first
      | exact eval_pc0 x y z g
      | exact eval_pc1 x y z g
      | exact eval_pc2 x y z g
      | exact eval_pc3 x y z g
      | exact eval_pc4 x y z g
      | exact eval_pc5 x y z g
      | exact eval_pc6 x y z g
      | exact eval_pc7 x y z g
      | exact eval_pc8 x y z g
      | exact eval_pc9 x y z g
      | exact eval_pc10 x y z g

