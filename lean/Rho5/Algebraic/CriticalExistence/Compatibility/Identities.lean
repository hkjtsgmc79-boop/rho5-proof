lemma point_coords (v : Vec) : Rho5.Algebraic.point (v 0) (v 1) (v 2) (v 3) = v := by
  funext i; fin_cases i <;> rfl

theorem criticalSystem_compat (v : Vec) :
    criticalSystem v =
      ![Rho5.Algebraic.P1 (v 0) (v 1) (v 2) (v 3),
        Rho5.Algebraic.P2 (v 0) (v 1) (v 2) (v 3),
        Rho5.Algebraic.P3 (v 0) (v 1) (v 2) (v 3),
        Rho5.Algebraic.J (v 0) (v 1) (v 2) (v 3)] := by
  funext i
  fin_cases i
  · change e00728.eval v = _
    rw [←Expr.eval_poly, show e00728.poly = Rho5.Algebraic.p1Poly from p1_poly_compat]
    simp [Rho5.Algebraic.P1,Rho5.Algebraic.ev,point_coords]
  · change e01504.eval v = _
    rw [←Expr.eval_poly, show e01504.poly = Rho5.Algebraic.p2Poly from p2_poly_compat]
    simp [Rho5.Algebraic.P2,Rho5.Algebraic.ev,point_coords]
  · change e02217.eval v = _
    rw [←Expr.eval_poly, show e02217.poly = Rho5.Algebraic.p3Poly from p3_poly_compat]
    simp [Rho5.Algebraic.P3,Rho5.Algebraic.ev,point_coords]
  · change e12242.eval v = _
    rw [←Expr.eval_poly,j_poly_compat]
    simp [Rho5.Algebraic.J,Rho5.Algebraic.ev,point_coords]

theorem box_compat (v : Vec) :
    InBox v ↔ Rho5.Algebraic.CandidateBox (v 0) (v 1) (v 2) (v 3) := by
  constructor
  · intro h
    refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩
    · simpa [InBox,MemBox,exactBox,QI.Mem,Rho5.Algebraic.xLower] using (h 0).1
    · simpa [InBox,MemBox,exactBox,QI.Mem,Rho5.Algebraic.xUpper] using (h 0).2
    · simpa [InBox,MemBox,exactBox,QI.Mem,Rho5.Algebraic.yLower] using (h 1).1
    · simpa [InBox,MemBox,exactBox,QI.Mem,Rho5.Algebraic.yUpper] using (h 1).2
    · simpa [InBox,MemBox,exactBox,QI.Mem,Rho5.Algebraic.zLower] using (h 2).1
    · simpa [InBox,MemBox,exactBox,QI.Mem,Rho5.Algebraic.zUpper] using (h 2).2
    · simpa [InBox,MemBox,exactBox,QI.Mem,Rho5.Algebraic.gLower] using (h 3).1
    · simpa [InBox,MemBox,exactBox,QI.Mem,Rho5.Algebraic.gUpper] using (h 3).2
  · intro h i
    fin_cases i
    · constructor
      · simpa [exactBox,QI.Mem,Rho5.Algebraic.xLower] using h.x_lower
      · simpa [exactBox,QI.Mem,Rho5.Algebraic.xUpper] using h.x_upper
    · constructor
      · simpa [exactBox,QI.Mem,Rho5.Algebraic.yLower] using h.y_lower
      · simpa [exactBox,QI.Mem,Rho5.Algebraic.yUpper] using h.y_upper
    · constructor
      · simpa [exactBox,QI.Mem,Rho5.Algebraic.zLower] using h.z_lower
      · simpa [exactBox,QI.Mem,Rho5.Algebraic.zUpper] using h.z_upper
    · constructor
      · simpa [exactBox,QI.Mem,Rho5.Algebraic.gLower] using h.g_lower
      · simpa [exactBox,QI.Mem,Rho5.Algebraic.gUpper] using h.g_upper

def OriginalCritical (v : Vec) : Prop :=
  Rho5.Algebraic.CandidateBox (v 0) (v 1) (v 2) (v 3) ∧
  Rho5.Algebraic.P1 (v 0) (v 1) (v 2) (v 3)=0 ∧
  Rho5.Algebraic.P2 (v 0) (v 1) (v 2) (v 3)=0 ∧
  Rho5.Algebraic.P3 (v 0) (v 1) (v 2) (v 3)=0 ∧
  Rho5.Algebraic.J (v 0) (v 1) (v 2) (v 3)=0

theorem original_iff (v : Vec) :
    OriginalCritical v ↔ InBox v ∧ criticalSystem v=0 := by
  rw [criticalSystem_compat]
  constructor
  · rintro ⟨hb,h1,h2,h3,hj⟩
    refine ⟨(box_compat v).mpr hb,?_⟩
    funext i; fin_cases i <;> simp [h1,h2,h3,hj]
  · rintro ⟨hb,hf⟩
    refine ⟨(box_compat v).mp hb,?_,?_,?_,?_⟩
    · simpa using congrFun hf 0
    · simpa using congrFun hf 1
    · simpa using congrFun hf 2
    · simpa using congrFun hf 3

end
end Rho5.Algebraic.CriticalExistence
