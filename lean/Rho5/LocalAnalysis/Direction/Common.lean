theorem tangentLift_norm_le (v : Y) : ‖tangentLift v‖ ≤ ‖v‖ := by
  apply (pi_norm_le_iff_of_nonneg (norm_nonneg v)).mpr
  intro i
  fin_cases i
  · change ‖v 0‖ ≤ ‖v‖
    exact norm_le_pi_norm v 0
  · change ‖v 1‖ ≤ ‖v‖
    exact norm_le_pi_norm v 1
  · change ‖v 2‖ ≤ ‖v‖
    exact norm_le_pi_norm v 2
  · change ‖v 3‖ ≤ ‖v‖
    exact norm_le_pi_norm v 3
  · change ‖v 4‖ ≤ ‖v‖
    exact norm_le_pi_norm v 4
  · change ‖v 5‖ ≤ ‖v‖
    exact norm_le_pi_norm v 5
  · change ‖v 6‖ ≤ ‖v‖
    exact norm_le_pi_norm v 6
  · change ‖(0 : ℝ)‖ ≤ ‖v‖
    simpa only [norm_zero] using norm_nonneg v
  · change ‖v 7‖ ≤ ‖v‖
    exact norm_le_pi_norm v 7
  · change ‖v 8‖ ≤ ‖v‖
    exact norm_le_pi_norm v 8
  · change ‖v 9‖ ≤ ‖v‖
    exact norm_le_pi_norm v 9
  · change ‖v 10‖ ≤ ‖v‖
    exact norm_le_pi_norm v 10
  · change ‖v 11‖ ≤ ‖v‖
