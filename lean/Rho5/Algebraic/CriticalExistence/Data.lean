def applyC (v : Vec) : Vec := fun i =>
  cMat i 0*v 0+cMat i 1*v 1+cMat i 2*v 2+cMat i 3*v 3
def applyW (v : Vec) : Vec := fun i =>
  wMat i 0*v 0+wMat i 1*v 1+wMat i 2*v 2+wMat i 3*v 3

theorem left_inverse_C (v : Vec) : applyW (applyC v) = v := by
  -- Repair note (D30): the delivered proof was
  --   `fin_cases i <;> norm_num [applyW,applyC,wMat,cMat] <;> ring`
  -- which fails because neither `norm_num` nor a hand-listed `simp only` reduces the
  -- `![…] i` indexing of `cMat`/`wMat`; the needed lemma is `Matrix.cons_val'` (the
  -- general `Fin (n+1)` case).  The explicit set below was produced by `simp?` inside
  -- this module's own import context, so it does not depend on the ambient simp set
  -- (plain `simp` passes in an isolated probe but fails here).
  funext i
  fin_cases i <;>
    simp only [applyW, applyC, wMat, cMat, Matrix.cons_val', Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val, Matrix.cons_val_fin_one, Fin.isValue,
      Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Rat.cast_neg, Rat.cast_ofNat,
      Rat.cast_one] <;>
    ring

theorem C_injective : Function.Injective applyC := by
  intro v w h
  have he := congrArg applyW h
  simpa only [left_inverse_C] using he

theorem C_zero : applyC 0 = 0 := by funext i; simp [applyC]

