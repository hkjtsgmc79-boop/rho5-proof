/-- Entries of the actual analytic four-variable Jacobian, with J itself still
being the three-variable determinant specified by the original input. -/
def jacobianEntry (v : Vec) (i j : Fin 4) : ℝ := (criticalExpr i).secant j v v

theorem has_partial (v : Vec) (i j : Fin 4) :
    HasDerivAt (fun t : ℝ => criticalSystem (Function.update v j t) i)
      (jacobianEntry v i j) (v j) :=
  (criticalExpr i).hasDerivAt_update j v

theorem newton_formula (v : Vec) (i : Fin 4) :
    (newtonExpr i).eval v = v i-applyC (criticalSystem v) i := by
  -- Repair note (D30): `Matrix.cons_val_zero/cons_val_succ` alone do not reduce the
  -- `![…] i` indexing for i = 1,2,3; the general `Matrix.cons_val'` plus the `Fin`
  -- literal lemmas are required (same defect as `Data.left_inverse_C`).
  fin_cases i <;> simp only [newtonExpr,criticalSystem,criticalExpr,applyC,cMat,
    e12298, e12297, e12296, e12295, e12294, e12293, e12292, e12291, e12290, e12289, e12288, e12287, e12286, e12285, e12284, e12283, e12282, e12281, e12280, e12279, e12278, e12277, e12276, e12275, e12274, e12273, e12272, e12271, e12270, e12269, e12268, e12267, e12266, e12265, e12264, e12263, e12262, e12261, e12260, e12259, e12258, e12257, e12256, e12255, e12254, e12253, e12252, e12251, e12250, e12249, e12248, e12247, e12246, e12245, e12244, e12243, e02218, e01505, e00014, e00010, e00001, Expr.eval,
    Matrix.cons_val',Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val,
    Matrix.cons_val_succ,Matrix.cons_val_fin_one,Fin.isValue,Fin.zero_eta,Fin.mk_one,
    Fin.reduceFinMk] <;> norm_num <;> ring

theorem delta_formula (v : Vec) (i : Fin 4) :
    (newtonExpr i).eval v-v i = (deltaExpr i).eval v := by
  fin_cases i <;> simp [newtonExpr,deltaExpr, e12298, e12284, e12270, e12256, e01505, e00014, e00010, e00001, Expr.eval]

end
