/-
D34 — coefficient bridge: D05's `pc_i` and D07's `pc_i` agree at the point.

GENERATED by `parallel/D34/scripts/gen_coeff_bridge.py` from the audited
certificate; the index list comes from the certificate, not from hand
transcription.  Each proof unfolds the two definitions and discharges a
one-variable polynomial identity over `ℝ` with `ring`.
-/
import Rho5.Algebraic.CriticalBridge
import Rho5.Algebraic.ScalarAlphaBridge.Bridge

noncomputable section

namespace Rho5.Algebraic.ScalarCandidateAlpha

open Rho5.Algebraic

set_option maxHeartbeats 0

/-- `ev` on a variable is the point's coordinate (`eval` is `eval₂Hom` at
`RingHom.id`; this exposes the library lemma for the D05 abbreviation). -/
theorem ev_X (v : Point) (i : Fin 4) : ev v (MvPolynomial.X i) = v i :=
  MvPolynomial.eval₂Hom_X' (RingHom.id ℝ) v i

/-- The same for the coordinate `g` used by every coefficient. -/
theorem ev_gVar (v : Point) : ev v gVar = v 3 := by
  rw [gVar, ev_X]

/-- The D05 `z`-coefficient list. -/
def pcAt (i : Fin 11) : Poly :=
  ![pc0, pc1, pc2, pc3, pc4, pc5, pc6, pc7, pc8, pc9, pc10] i

/-- The D07 `z`-coefficient list, evaluated at `g`. -/
def bezoutPcAt (g : ℝ) (i : Fin 11) : ℝ :=
  ![BezoutChecks.pc0 g, BezoutChecks.pc1 g, BezoutChecks.pc2 g,
    BezoutChecks.pc3 g, BezoutChecks.pc4 g, BezoutChecks.pc5 g,
    BezoutChecks.pc6 g, BezoutChecks.pc7 g, BezoutChecks.pc8 g,
    BezoutChecks.pc9 g, BezoutChecks.pc10 g] i

theorem eval_pc0 (x y z g : ℝ) :
    ev (point x y z g) pc0 = BezoutChecks.pc0 g := by
  simp only [pc0, BezoutChecks.pc0, gVar, ev_X, map_mul, map_pow,
    map_add, map_ofNat, map_sub, map_neg]
  simp [point, Matrix.cons_val]
  ring

