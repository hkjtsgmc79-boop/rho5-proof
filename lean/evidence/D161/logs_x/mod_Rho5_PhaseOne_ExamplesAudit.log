                (And (Rho5.ExternalTailSaturation.LeadingInput P)
                  (And (Eq.{1} (Rho5.ExternalTailSaturation.height P) Rho5.GrowthSupremum.rho5Trace)
                    (And (LT.lt.{0} 4 (Rho5.ExternalTailSaturation.height P))
                      (And (Eq.{1} (Rho5.matrixEntryMax P) 1)
                        (And
                          (Rho5.CompletePivotPath.LegalTrace P
