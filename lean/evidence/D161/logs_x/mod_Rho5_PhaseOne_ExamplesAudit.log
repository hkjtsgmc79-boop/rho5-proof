        (And (LE.le.{0} Rho5.Algebraic.AlphaRoot.alpha Rho5.GrowthSupremum.rho5Trace)
          (And (LE.le.{0} Rho5.GrowthSupremum.rho5Trace (81 / 16))
            (∃ P values,
